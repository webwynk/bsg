# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# this project uses pnpm (pnpm-lock.yaml is the real lockfile) -- ignore
# npm's own lockfile so an accidental `npm install` can't silently commit
# a mismatched one again (see the ERR_PNPM_OUTDATED_LOCKFILE deploy failure
# this caused, fixed 2026-08-23)
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
